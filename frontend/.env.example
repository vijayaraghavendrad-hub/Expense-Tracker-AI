# Backend API URL - Set this in Vercel/Render dashboard (do NOT commit a .env with a real value)
# Point to your Render service ROOT URL — the /api path is appended automatically by the app.
# Examples:
#   https://smart-expense-tracker-api.onrender.com
#   https://smart-expense-tracker-api.up.railway.app
#
# Leave EMPTY for local dev — the Vite proxy handles routing /api → localhost:8000
VITE_API_BASE_URL=
