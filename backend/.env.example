# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file

# Render PostgreSQL connection string (from Render Dashboard → Database → Info)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# Set to 1 to enable auto-shutdown when browser is closed
ENABLE_AUTO_SHUTDOWN=0

# CORS origins for production (comma-separated)
# Example: https://your-app.vercel.app,https://another-domain.com
CORS_ORIGINS=

# Optional: JWT secret key (defaults to built-in key if not set)
# SECRET_KEY=your-custom-secret-key
