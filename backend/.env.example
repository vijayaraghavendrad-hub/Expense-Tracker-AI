# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file

# Supabase PostgreSQL connection string (Transaction Mode pooler - port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Supabase project URL and anon key (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Set to 1 to enable auto-shutdown when browser is closed
ENABLE_AUTO_SHUTDOWN=0

# CORS origins for production (comma-separated)
# Example: https://your-app.vercel.app,https://another-domain.com
CORS_ORIGINS=

# Optional: JWT secret key (defaults to built-in key if not set)
# SECRET_KEY=your-custom-secret-key
